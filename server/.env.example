# cpitracker server — required env vars
# (PORT is injected by Railway in production; local default = 3001)

# Solana RPC endpoints
# Mainnet is the default cluster — used by /api/analyze when no ?network query.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Devnet — used when /api/analyze?network=devnet is requested.
DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Local dev port (Railway overrides via PORT env)
PORT=3001
