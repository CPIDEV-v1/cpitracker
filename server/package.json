{
  "name": "cpitracker-server",
  "version": "0.1.0",
  "description": "CPI call tree analysis server for Solana transactions",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc && cp -r src/data dist/data",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
